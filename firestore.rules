rules_version = '2';

// Reversi online security rules (tightened in REV-51).
//
// Core principle: clients may only write the "safe" identity fields of their
// own profile. Everything that affects ranking — xp, level and the online
// stats — is written exclusively by Cloud Functions via the Admin SDK, which
// bypasses these rules. So a player can never edit their own XP/level/stats.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      // Any signed-in user can read profiles.
      allow read: if signedIn();

      // Owner may create their profile with only identity fields.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
             ['displayName', 'photoUrl', 'createdAt', 'updatedAt']);

      // Owner may update only identity fields. xp / level / online.* are
      // owned by Cloud Functions and can never be touched by the client.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['displayName', 'photoUrl', 'updatedAt']);

      allow delete: if false;

      // Marketing consent (REV-117). The current answer is the owner's to
      // write — it is their own permission, not a balance — but the log under
      // it is append-only: proof of consent is worthless if it can be
      // rewritten afterwards. `at` must be the server's clock so a device
      // with a wrong date cannot backdate an answer.
      match /consents/{type} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['type', 'granted', 'at', 'policyVersion', 'source'])
          && request.resource.data.granted is bool
          && request.resource.data.at == request.time;
        allow delete: if false;

        match /log/{recordId} {
          allow read: if isOwner(uid);
          allow create: if isOwner(uid)
            && request.resource.data.keys().hasOnly(
                 ['type', 'granted', 'at', 'policyVersion', 'source'])
            && request.resource.data.granted is bool
            && request.resource.data.at == request.time;
          allow update, delete: if false;
        }
      }

      // Push device tokens (REV-111). A subcollection, not a field on the
      // profile: the update whitelist above is what keeps coins and trophies
      // server-owned, and it is not being widened so a token can sit next to
      // them. The owner may add and remove their own devices — they are the
      // only one who can produce a token for a device they hold — but may not
      // read another player's, and nothing here can name a recipient.
      //
      // Both timestamps must be the server's clock, for the same reason the
      // consent record's is: a device with a wrong date must not be able to
      // claim a token was last used tomorrow. `createdAt` is write-once — the
      // update rule cannot touch it — so "first registered" stays true across
      // every later launch.
      match /devices/{token} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(
               ['platform', 'lang', 'createdAt', 'lastSeenAt'])
          && request.resource.data.platform is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.lastSeenAt == request.time;
        // Re-registering on a later launch: the device says it is still here,
        // and may correct its language. Nothing else moves.
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
               ['platform', 'lang', 'lastSeenAt'])
          && request.resource.data.lastSeenAt == request.time;
        allow delete: if isOwner(uid);
      }

      // Per-game progress history (REV-54), used for the online stats
      // trend charts (REV-58). Written exclusively by Cloud Functions.
      match /history/{gameId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Weekly leaderboard counters (REV-55): any signed-in user can read the
    // rankings; only Cloud Functions (Admin SDK) write them.
    match /leaderboards/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Matchmaking tickets: a user only manages their own ticket. The actual
    // pairing is done by a Cloud Function (Admin SDK). Tightened in REV-43.
    match /matchmaking/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // Returns true when the update touches any board-state field, i.e. it
    // is a move submission rather than a heartbeat, resign, or cancel.
    function isMoveWrite() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['board', 'moves', 'moveCount', 'currentPlayer',
                             'lastMove', 'turnDeadline']);
    }

    // Returns true when it is the requesting player's turn.
    function isMyTurn() {
      return (resource.data.currentPlayer == 'black'
              && request.auth.uid == resource.data.players.black)
          || (resource.data.currentPlayer == 'white'
              && request.auth.uid == resource.data.players.white);
    }

    // Games: only the two participants may read. The game doc is created by
    // the matchmaking function (Admin SDK — bypasses these rules).
    // During an active game:
    //   - Any participant may do a non-board write (heartbeat, resign,
    //     claimDisconnectWin, cancel).
    //   - Board-changing writes (move submissions) are additionally
    //     restricted to the player whose turn it is (REV-51 anti-cheat).
    // Finished or cancelled games are read-only.
    match /games/{gameId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerUids;

      allow update: if signedIn()
        && request.auth.uid in resource.data.playerUids
        && resource.data.status == 'active'
        && (!isMoveWrite() || isMyTurn());

      allow create, delete: if false;
    }
  }
}
