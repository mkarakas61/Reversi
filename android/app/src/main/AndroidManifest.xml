<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications (REV-111). On Android 13+ this is a *runtime*
         permission: declaring it here only makes it askable, and a player who
         says no never receives a single notification. It is therefore asked in
         context (when joining the matchmaking queue), never at launch — an
         early ask gets refused, and a refused ask cannot be repeated. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ paket görünürlüğü: url_launcher, bu intent'leri
         çözebilmek için burada beyan edilmelerini şart koşuyor. Gizlilik
         politikası / koşullar bağlantıları (https) ve destek + hesap silme
         talebi (mailto) bunlar olmadan sessizce açılmaz (REV-91). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
    </queries>

    <application
        android:label="Reversi"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- How a notification that arrives while the app is closed is drawn.
             Without the icon entry Android falls back to the launcher icon and
             renders it as a white square; without the channel entry the
             notification lands in a system-made "Miscellaneous" channel the
             player cannot recognise. The channel itself is created in
             MainActivity — declaring an id here does not create it. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="reversi_general" />
    </application>
</manifest>
