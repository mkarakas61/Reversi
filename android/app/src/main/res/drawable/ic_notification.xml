<!-- Status-bar icon for push notifications (REV-111).

     Android throws away every colour here and keeps only the alpha channel,
     tinting the silhouette itself — so this is drawn as flat white shapes, and
     handing it the launcher icon instead would produce the familiar white
     blob. A vector rather than five PNG densities: it is four circles, and a
     drawable that scales itself cannot be shipped at the wrong size.

     The motif is the app's own: the 2x2 board corner, two discs laid and two
     still open. Rings are drawn as two subpaths under evenOdd, which punches
     the middle out instead of covering it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Laid discs: top-left and bottom-right. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M7,3.2 a3.8,3.8 0 1,0 0,7.6 a3.8,3.8 0 1,0 0,-7.6 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M17,13.2 a3.8,3.8 0 1,0 0,7.6 a3.8,3.8 0 1,0 0,-7.6 Z" />

    <!-- Open squares: top-right and bottom-left, drawn as rings. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M17,3.2 a3.8,3.8 0 1,0 0,7.6 a3.8,3.8 0 1,0 0,-7.6 Z
                          M17,5.1 a1.9,1.9 0 1,0 0,3.8 a1.9,1.9 0 1,0 0,-3.8 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M7,13.2 a3.8,3.8 0 1,0 0,7.6 a3.8,3.8 0 1,0 0,-7.6 Z
                          M7,15.1 a1.9,1.9 0 1,0 0,3.8 a1.9,1.9 0 1,0 0,-3.8 Z" />
</vector>
